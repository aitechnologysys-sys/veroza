# Configuration reference: see README.md and the docs/ folder in this repo

# === Required Settings

# Single source of truth for the dev Postgres role — read directly by
# docker-compose.dev.yaml (Compose ${...} substitution) and expanded into
# DATABASE_URL below via dotenv-expand, so the two can never drift apart.
# Change these before first `docker compose -f docker-compose.dev.yaml up` if
# you want your own values; the defaults below work out of the box otherwise.
POSTARYX_DEV_DB_USER="postaryx-local"
POSTARYX_DEV_DB_PASSWORD="postaryx-local-pwd"
POSTARYX_DEV_DB_NAME="postaryx-db-local"

# Same idea, for docker-compose.yaml (prod) if you run that stack locally for
# a rehearsal — see README.md §2. Not used by `pnpm dev`. Pick your own values.
POSTARYX_DB_USER="postaryx-user"
POSTARYX_DB_PASSWORD="change-me-to-a-strong-password"
POSTARYX_DB_NAME="postaryx-db-prod"

# Redis auth for the PROD stack only (docker-compose.yaml's postaryx-redis) —
# see docs/1.SECURITY-HARDENING-TODO.md P1-3. Dev's Redis is intentionally left
# password-free for zero-friction local debugging.
POSTARYX_REDIS_PASSWORD="change-me-to-a-strong-password"

# Temporal's own internal Postgres password (used by both stacks — Temporal's
# DB has no host port anywhere, so this is hygiene, not an exposure fix). Dev
# can keep upstream's "temporal" default since nothing external ever reaches
# it; pick a real generated value for the prod one.
POSTARYX_DEV_TEMPORAL_DB_PASSWORD="temporal"
POSTARYX_TEMPORAL_DB_PASSWORD="change-me-to-a-strong-password"
POSTARYX_API_URL="https://api.postaryx.com"
POSTARYX_DOMAIN="https://postaryx.com"
POSTARYX_SUPPORT_EMAIL="support@postaryx.com"
NEXT_PUBLIC_POSTARYX_UPLOAD_URL="https://uploads.postaryx.com"

DATABASE_URL="postgresql://${POSTARYX_DEV_DB_USER}:${POSTARYX_DEV_DB_PASSWORD}@localhost:5432/${POSTARYX_DEV_DB_NAME}"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="random string for your JWT secret, make it long"

# === This needs to be exactly the URL you're accessing Postaryx on
FRONTEND_URL="http://localhost:4200"
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"
BACKEND_INTERNAL_URL="http://localhost:3000"
## This needs to be changed to https://app.postaryx.com if you are using the official Postaryx SaaS, or your own domain if self-hosting.
POSTARYX_PUBLIC_URL="https://app.postaryx.com"

## Only needed if STORAGE_PROVIDER="cloudflare" below. Create your own: Cloudflare
## dashboard → R2 → create bucket, then R2 → "Manage API tokens" → create a token
## scoped to that bucket. Remember to add your server's public IP to the token's
## allow-list.
##
## CLOUDFLARE_BUCKET_URL must be the bucket's PUBLIC URL — either the r2.dev subdomain
## (R2 → your bucket → Settings → enable "Public access") or a custom domain you attach
## to the bucket. It is NOT the r2.cloudflarestorage.com S3 API endpoint, which requires
## signed requests and cannot serve files to browsers or social platforms.
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_ACCESS_KEY="your-access-key"
CLOUDFLARE_SECRET_ACCESS_KEY="your-secret-access-key"
CLOUDFLARE_BUCKETNAME="your-bucket-name"
CLOUDFLARE_BUCKET_URL="https://your-public-bucket-url"
CLOUDFLARE_REGION="auto"
## Optional media normalization (postiz-uploader on RunPod Serverless). Requires STORAGE_PROVIDER="cloudflare".
## When set, web uploads are transcoded to 1080p h264 mp4 / downsized images in the background;
## the media record reports status "processing" until the normalized file replaces the original.
#RUNPOD_API_KEY=""
#RUNPOD_ENDPOINT_ID=""
## Local development only: point the RunPod endpoints at a local postiz-uploader (python -m postiz_uploader.devapi,
## or its docker compose, port 8000 unless UPLOADER_PORT moves it). Leave unset in production. If a local Temporal
## already holds port 8000, start the uploader with UPLOADER_PORT=18000 and use "http://localhost:18000/v2" here.
#RUNPOD_API_URL="http://localhost:8000/v2"
## Optional video clipping (YouTube video -> captioned vertical clips -> draft posts). Requires STORAGE_PROVIDER="cloudflare",
## RUNPOD_API_KEY (with access to both endpoints below) and OPENAI_API_KEY. Ingest jobs go to the CPU endpoint, clip jobs to the
## GPU endpoint of postiz-uploader (which needs its own Oxylabs account to fetch from YouTube); Deepgram transcribes videos
## that have no usable captions.
#RUNPOD_INGEST_ENDPOINT_ID=""
#RUNPOD_CLIPPER_ENDPOINT_ID=""
#DEEPGRAM_API_KEY=""

# === Common optional Settings

## Email provider: "resend", "ses" or "nodemailer".
## If it is set to one of them, user activation is required.
## If it is commented out, users are activated automatically.
#EMAIL_PROVIDER="resend"
#EMAIL_FROM_ADDRESS=""
#EMAIL_FROM_NAME=""
## Default Reply-To for every email, so replies to a no-reply sender reach a real inbox.
#EMAIL_REPLY_TO=""

## This is a dummy key, you must create your own from Resend.
#RESEND_API_KEY="RzeTwHijvxvPUerScFcenUZUALuQJzSaGSMJ"

## Amazon SES: EMAIL_FROM_ADDRESS must be a verified identity in SES_REGION,
## and a sandboxed SES account can only send to verified addresses.
## Without SES_ACCESS_KEY the default AWS credential chain is used
## (AWS_* env vars, ECS task role, EC2 instance profile), it needs ses:SendEmail.
#SES_REGION="us-east-1"
#SES_ACCESS_KEY=""
#SES_SECRET_ACCESS_KEY=""

#DISABLE_REGISTRATION=false

# Where media/avatars are stored: "local" or "cloudflare" (R2, see CLOUDFLARE_* below).
# "local" is fine for a single-instance/self-hosted setup. For a multi-instance or
# SaaS deployment, use "cloudflare" — local storage ties uploads to one container's
# disk, which breaks horizontal scaling and zero-downtime deploys.
STORAGE_PROVIDER="local"

# Your upload directory path if you host your files locally. Unused if STORAGE_PROVIDER="cloudflare".
# A relative path (e.g. "uploads") resolves against the monorepo root, portable
# across machines. An absolute path (e.g. the "/uploads" used inside the prod
# Docker container) is used as-is.
UPLOAD_DIRECTORY="uploads"

# Your upload directory slug if you host your files locally. Unused if STORAGE_PROVIDER="cloudflare".
#NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=""

# Only needed if you run your own Canva app: its origin from the Canva
# Developer Portal (Security -> Credentials), allowed by CORS on the backend.
#CANVA_APP_ORIGIN="https://app-xxxxxxxxxxx.canva-apps.com"

# Sign in with Apple (login provider)
# APPLE_BUNDLE_ID: iOS app bundle id (native mobile sign-in)
# APPLE_SERVICE_ID / TEAM_ID / KEY_ID / PRIVATE_KEY: web sign-in (Services ID + .p8 key)
APPLE_BUNDLE_ID=""
APPLE_SERVICE_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Social Media API Settings
X_URL=""
X_API_KEY=""
X_API_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Sign in with Apple, client id is the Services ID identifier
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
# --- Sign in with Farcaster (Neynar)
#NEYNAR_CLIENT_ID="" # still gates the Farcaster login button in the UI
#NEYNAR_SECRET_KEY=""
#NEYNAR_APP_FID="" # Farcaster id of the account that represents your app (the one users see requesting access)
#NEYNAR_APP_MNEMONIC="" # recovery phrase of that account's custody wallet, used only to sign managed-signer key requests
#NEYNAR_SPONSOR_SIGNERS="false" # "true" lets Neynar pay the on-chain signer fee (billed to your Neynar credits); otherwise the user pays in Warpcast
BEEHIIVE_API_KEY=""
BEEHIIVE_PUBLICATION_ID=""
LISTMONK_DOMAIN=""
LISTMONK_USER=""
LISTMONK_API_KEY=""
LISTMONK_LIST_ID=""
# --- Meta apps
# One app can serve several providers, and a provider is only usable when its
# own app's credentials are set. The app secret is also what verifies Meta's
# deauthorize and data-deletion callbacks (POST /meta/<app>/...), so a provider
# with no secret here rejects every callback Meta sends for it.
#   FACEBOOK_*  -> the "facebook" (Facebook Page) and "instagram" providers
#   INSTAGRAM_* -> the "instagram-standalone" provider (Instagram Login)
#   THREADS_*   -> the "threads" provider
THREADS_APP_ID=""
THREADS_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

GOOGLE_SSO_CLIENT_ID=""
GOOGLE_SSO_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_BUSINESS_CLIENT_ID=""
TIKTOK_BUSINESS_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
PINTEREST_API_BASE="https://api-sandbox.pinterest.com" # only for Trial-access demos; set on backend + orchestrator, then reconnect Pinterest
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""
TUMBLR_CLIENT_ID=""
TUMBLR_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""

# Chrome Extension Settings (for cookie-based platform integrations like Skool)
EXTENSION_ID=""

# Misc Settings
OPENAI_API_KEY=""
# OAuth client configured for the ChatGPT app. Only this client can receive
# verified user email claims for ChatGPT Enterprise domain restrictions.
OPENAI_OAUTH_CLIENT_ID=""
# Client id of the OAuth app (Settings > Developers) that HubSpot agents
# connect with. HubSpot sends no client secret, so this one app uses PKCE
# instead, gets a refresh token, and the MCP backend answers OAuth discovery
# at its domain root. Set it on both the API and the MCP backend.
# HUBSPOT_OAUTH_CLIENT_ID=""
# Client id and secret of the HubSpot app itself (HubSpot project > app >
# Auth tab), not of the Postiz app above. Its redirect URL is
# <NEXT_PUBLIC_BACKEND_URL>/oauth/hubspot/callback, which finishes the install
# (HubSpot only counts it once the code is exchanged). Set them on the API.
# HUBSPOT_APP_CLIENT_ID=""
# HUBSPOT_APP_CLIENT_SECRET=""
# MCP OAuth Dynamic Client Registration (RFC 7591) redirect-domain allowlist.
# When set (comma separated), POST /oauth/register only accepts redirect_uris
# whose host matches a listed domain or one of its subdomains; unset or empty
# means any client can self-register. Only https callbacks are checked:
# loopback (http://localhost:8787/callback - Grok, Claude Code) and
# private-use scheme callbacks (cursor://...) stay on the user's machine
# and are always accepted. Example locks web callbacks to the claude.ai
# connector; add cursor.com for Cursor.
# DCR_VERIFIED_DOMAINS="claude.ai,claude.com"
# Upstream (Postiz Cloud) only: lets people connect a self-hosted instance on the
# MCP consent screen ("Use self-hosted"); its MCP tool calls are relayed there
# with its API key. Leave unset unless you deliberately offer that relay.
# MCP_SELF_HOSTED_RELAY=true
# EVOLINK_API_KEY="" # EvoLink API key for Seedance AI video generation (https://evolink.ai)
NEXT_PUBLIC_DISCORD_SUPPORT=""
NEXT_PUBLIC_POLOTNO=""
NEXT_PUBLIC_POSTARYX_EXTENSION_URL=""
# NOT_SECURED=false
API_LIMIT=30 # The limit of the public API hour limit

# When connecting providers that take a self-hosted URL (WordPress, Mastodon,
# Lemmy, Listmonk, Bluesky PDS, etc.) Postiz fetches that URL server-side and
# blocks requests that resolve to private/internal/loopback/link-local IPs to
# prevent SSRF. Set to true ONLY if your Postiz instance must reach those
# services on a trusted private network (e.g. same Docker network or VPC).
# DISABLE_SSRF_PROTECTION=false

# Payment settings
#
# BILLING_ENABLED is the single source of truth for whether billing is enforced.
# Leave it unset (or anything other than "true") for free self-hosted mode:
# every org is treated as ULTIMATE, no channel/credit/team limits are applied,
# permission checks pass, and the billing UI is hidden.
# BILLING_PROVIDER picks the gateway once billing is on: "stripe" (default) | "polar"
# See docs/billing-current-state.md.
BILLING_ENABLED="false"
BILLING_PROVIDER="stripe"

# Stripe — Dashboard → Developers → API keys. Webhook endpoint: POST /stripe
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_SIGNING_KEY=""
STRIPE_DISCOUNT_ID=""   # optional: coupon id for the loyalty discount

# Polar — only read when BILLING_PROVIDER="polar". Webhook endpoint: POST /payment-webhook
POLAR_SERVER=""         # "sandbox" for the Polar sandbox, empty for production
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_PRICE_STANDARD_MONTHLY=""
POLAR_PRICE_STANDARD_YEARLY=""
POLAR_PRICE_TEAM_MONTHLY=""
POLAR_PRICE_TEAM_YEARLY=""
POLAR_PRICE_PRO_MONTHLY=""
POLAR_PRICE_PRO_YEARLY=""
POLAR_PRICE_ULTIMATE_MONTHLY=""
POLAR_PRICE_ULTIMATE_YEARLY=""

# RevenueCat (App Store / Google Play subscriptions from upstream's mobile app)
# Webhook URLs: {BACKEND_URL}/payment/stripe and {BACKEND_URL}/payment/revenuecat, Authorization header value = REVENUECAT_WEBHOOK_SECRET
REVENUECAT_SECRET_KEY=""
REVENUECAT_WEBHOOK_SECRET=""
# IN_APP_PURCHASE_REJECT_SANDBOX=true

# Developer Settings
NX_ADD_PLUGINS=false
IS_GENERAL="true" # required for now
NEXT_PUBLIC_POSTARYX_OAUTH_DISPLAY_NAME="Authentik"
NEXT_PUBLIC_POSTARYX_OAUTH_LOGO_URL="https://raw.githubusercontent.com/walkxcode/dashboard-icons/master/png/authentik.png"
POSTARYX_GENERIC_OAUTH="false"
POSTARYX_OAUTH_URL="https://auth.example.com"
POSTARYX_OAUTH_AUTH_URL="https://auth.example.com/application/o/authorize"
POSTARYX_OAUTH_TOKEN_URL="https://auth.example.com/application/o/token"
POSTARYX_OAUTH_USERINFO_URL="https://authentik.example.com/application/o/userinfo"
POSTARYX_OAUTH_CLIENT_ID=""
POSTARYX_OAUTH_CLIENT_SECRET=""
# Deprecated compatibility aliases still supported at runtime:
# NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME=""
# NEXT_PUBLIC_POSTIZ_OAUTH_LOGO_URL=""
# POSTIZ_GENERIC_OAUTH=""
# POSTIZ_OAUTH_AUTH_URL=""
# POSTIZ_OAUTH_TOKEN_URL=""
# POSTIZ_OAUTH_USERINFO_URL=""
# POSTIZ_OAUTH_CLIENT_ID=""
# POSTIZ_OAUTH_CLIENT_SECRET=""

# Short Link Service Settings
# DUB_TOKEN="" # Your self-hosted Dub API token
# DUB_API_ENDPOINT="https://api.dub.co" # Your self-hosted Dub API endpoint
# DUB_SHORT_LINK_DOMAIN="dub.sh" # Your self-hosted Dub domain

# SHORT_IO_SECRET_KEY="" # Your Short.io API secret key

# KUTT_API_KEY="" # Your Kutt.it API key
# KUTT_API_ENDPOINT="https://kutt.it/api/v2" # Your self-hosted Kutt API endpoint
# KUTT_SHORT_LINK_DOMAIN="kutt.it" # Your self-hosted Kutt domain

# LINK_DRIP_API_KEY="" # Your LinkDrip API key
# LINK_DRIP_API_ENDPOINT="https://api.linkdrip.com/v1/" # Your self-hosted LinkDrip API endpoint
# LINK_DRIP_SHORT_LINK_DOMAIN="dripl.ink" # Your self-hosted LinkDrip domain

# reCAPTCHA Settings (invisible v2 on anonymous preview comments, optional; unset = no captcha)
# RECAPTCHA_SITE_KEY="" # Your reCAPTCHA v2 invisible site key
# RECAPTCHA_SECRET_KEY="" # Your reCAPTCHA v2 invisible secret key

#.env.prod should have 
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""
MASTODON_URL="https://mastodon.social"

# Telegram — create a bot with @BotFather (/newbot).
# TELEGRAM_TOKEN is the HTTP API token it returns; TELEGRAM_BOT_NAME is the
# bot username without the leading @, shown to users in the connect dialog.
TELEGRAM_TOKEN=""
TELEGRAM_BOT_NAME=""

# Whop — create an OAuth app in the Whop developer dashboard; redirect URI is
# ${FRONTEND_URL}/integrations/social/whop. WHOP_CLIENT_SECRET is the app's
# OAuth client secret (not an "apik_" API key); required if the app is a
# confidential client, leave empty for a public (PKCE-only) client.
WHOP_CLIENT_ID=""
WHOP_CLIENT_SECRET=""

TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
# Meta deauthorization / data-deletion callbacks.
# The signed_request HMAC is verified with the app secret above
# (FACEBOOK_APP_SECRET, INSTAGRAM_APP_SECRET, THREADS_APP_SECRET), so no extra
# secret is needed here.
#
# Failed, unmapped or stalled deletion requests alert through Sentry, which is
# shared with the rest of the backend. Without a DSN those alerts only reach the
# logs, and the alert is reported as undelivered.

# Server-side Sentry DSN for the backend and orchestrator. Preferred over
# NEXT_PUBLIC_SENTRY_DSN, which is a Next.js browser-bundle convention; the old
# name still works as a fallback.
SENTRY_DSN=""

# Console levels forwarded to Sentry. Defaults to "warn,error".
# Widening this to include `log`/`info` will transmit any console output the
# app produces, including provider code that logs whole credential objects.
SENTRY_CONSOLE_LEVELS=""

# Send AI prompts and completions to Sentry. Off unless set to "true", since
# they are user content.
SENTRY_RECORD_AI_IO=""


# Provider visibility / migration
# HIDDEN_PROVIDERS="tiktok" # comma-separated identifiers hidden from the add-channel screen
# MIGRATE_PROVIDERS="tiktok:tiktok-business" # comma-separated "old:new" pairs, a reconnect of "old" goes through "new" and the channel is migrated in place
