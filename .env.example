# Chrome Extension Settings (for cookie-based platform integrations like Skool)
EXTENSION_ID=""

# Misc Settings
OPENAI_API_KEY=""
NEXT_PUBLIC_DISCORD_SUPPORT=""
NEXT_PUBLIC_POLOTNO=""
# NOT_SECURED=false
API_LIMIT=30 # The limit of the public API hour limit

# Payment settings
#
# BILLING_ENABLED is the single source of truth for whether billing is enforced.
# Leave it unset (or anything other than "true") for free self-hosted mode:
# every org is treated as ULTIMATE, no channel/credit/team limits are applied,
# permission checks pass, and the billing UI is hidden.
# BILLING_PROVIDER picks the gateway once billing is on: "stripe" (default) | "polar"
# See docs/billing-current-state.md.
BILLING_ENABLED="false"
BILLING_PROVIDER="stripe"

# Stripe — Dashboard → Developers → API keys. Webhook endpoint: POST /stripe
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_SIGNING_KEY=""
STRIPE_DISCOUNT_ID=""   # optional: coupon offered when a user clicks cancel ("50% off for 3 months")

# Founding-100 launch promo — the first 100 paying customers get 52% off yearly /
# 24% off monthly, forever. Applied automatically at checkout, no code to enter.
# Independent of BILLING_ENABLED and BILLING_PROVIDER, and read only through
# isFoundingPromoEnabled(). Stripe only — has no effect under BILLING_PROVIDER="polar".
# Percentages and the slot count live in founding.promo.ts, not here. The frontend
# reads promo state from GET /billing/founding-promo, so there is no NEXT_PUBLIC_ mirror.
# See implementation-docs/founding-100-promo.md
FOUNDING_PROMO_ENABLED="false"

# Polar — only read when BILLING_PROVIDER="polar". Webhook endpoint: POST /payment-webhook
POLAR_SERVER=""         # "sandbox" for the Polar sandbox, empty for production
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_PRICE_STANDARD_MONTHLY=""
POLAR_PRICE_STANDARD_YEARLY=""
POLAR_PRICE_TEAM_MONTHLY=""
POLAR_PRICE_TEAM_YEARLY=""
POLAR_PRICE_PRO_MONTHLY=""
POLAR_PRICE_PRO_YEARLY=""
POLAR_PRICE_ULTIMATE_MONTHLY=""
POLAR_PRICE_ULTIMATE_YEARLY=""

# Developer Settings
NX_ADD_PLUGINS=false
IS_GENERAL="true" # required for now
NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME="Authentik"
NEXT_PUBLIC_POSTIZ_OAUTH_LOGO_URL="https://raw.githubusercontent.com/walkxcode/dashboard-icons/master/png/authentik.png"
POSTIZ_GENERIC_OAUTH="false"
POSTIZ_OAUTH_URL="https://auth.example.com"
POSTIZ_OAUTH_AUTH_URL="https://auth.example.com/application/o/authorize"
POSTIZ_OAUTH_TOKEN_URL="https://auth.example.com/application/o/token"
POSTIZ_OAUTH_USERINFO_URL="https://authentik.example.com/application/o/userinfo"
POSTIZ_OAUTH_CLIENT_ID=""
POSTIZ_OAUTH_CLIENT_SECRET=""
# POSTIZ_OAUTH_SCOPE="openid profile email" # default values

