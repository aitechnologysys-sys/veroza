# ===========================================================================
# Production environment file — used by docker-compose.yaml (prod stack).
#
# NOTE: The following vars are OVERRIDDEN by the `environment:` block in
# docker-compose.yaml and do NOT need to match what you set here:
#   DATABASE_URL, REDIS_URL, TEMPORAL_ADDRESS,
#   MAIN_URL, FRONTEND_URL, NEXT_PUBLIC_BACKEND_URL, BACKEND_INTERNAL_URL,
#   IS_GENERAL, DISABLE_REGISTRATION,
#   STORAGE_PROVIDER, UPLOAD_DIRECTORY, NEXT_PUBLIC_UPLOAD_DIRECTORY
#
# Everything else (secrets, API keys, billing, social OAuth) MUST be filled
# in here — the compose file does not override them.
# ===========================================================================

# Required Settings
